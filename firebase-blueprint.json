{
  "entities": {
    "Child": {
      "title": "Child Profile",
      "description": "Profile information of a kid tracking homework",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique child identifier (e.g. kate, damon)"
        },
        "name": {
          "type": "string",
          "description": "Name of the child"
        },
        "year": {
          "type": "string",
          "description": "School year of the child"
        },
        "passcode": {
          "type": "string",
          "description": "A 4-digit numeric passcode to submit items"
        },
        "subjects": {
          "type": "array",
          "description": "List of subjects/items the child is tracked on"
        }
      },
      "required": ["id", "name", "year", "passcode", "subjects"]
    },
    "TaskLog": {
      "title": "Task Log",
      "description": "Completed task items for a single kid on a specific date",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Composite key like childId_YYYY-MM-DD"
        },
        "childId": {
          "type": "string",
          "description": "Reference to the child's ID"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date format YYYY-MM-DD"
        },
        "completions": {
          "type": "object",
          "description": "Key-value pair of subject: boolean states"
        },
        "notes": {
          "type": "string",
          "description": "Daily thoughts or comments"
        },
        "completedRatio": {
          "type": "number",
          "description": "Ratio of tasks completed (0.0 to 1.0)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "childId", "date", "completions", "completedRatio"]
    },
    "SummaryReport": {
      "title": "Summary Report",
      "description": "AI-generated progress summary reports for parent insights",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Date YYYY-MM-DD for which report is generated"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date of the report"
        },
        "summary": {
          "type": "string",
          "description": "AI generated Markdown commentary"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "date", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/children/{childId}": {
      "schema": "Child",
      "description": "Child profile collection"
    },
    "/taskLogs/{logId}": {
      "schema": "TaskLog",
      "description": "Daily child task completion logs"
    },
    "/summaryReports/{reportId}": {
      "schema": "SummaryReport",
      "description": "Daily progress summaries generated by AI"
    }
  }
}
